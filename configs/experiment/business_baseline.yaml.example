experiment_id: business_baseline_v001
seed: 42
data: configs/data/local_business.yaml
model: configs/model/mobilenetv3_lite_unet.yaml
loss: configs/loss/bce_dice.yaml
distillation: null
augmentation:
  enabled: true
  horizontal_flip_probability: 0.5
  vertical_flip_probability: 0.0
  rotate_90_probability: 0.0
  brightness: 0.15
  contrast: 0.15
training:
  epochs: 100
  batch_size: 4
  learning_rate: 0.0003
  weight_decay: 0.0001
  num_workers: 2
  early_stopping_patience: 15
  freeze_batch_norm: true
  mixed_precision: true
  device: auto
output_dir: artifacts/business_baseline_v001
